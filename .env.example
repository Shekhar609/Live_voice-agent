# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database Configuration
# Default is local SQLite. In production (Render/Railway/Fly.io), set DATABASE_URL to PostgreSQL:
# e.g.: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./transcriptions.db

# Speech-to-Text Configuration
# Optional: Set your Gemini API key for server-side Gemini 3.1 / 2.0 Live transcription
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=
